# ─────────────────────────────────────────────────────────────────────────────
# vastlint-mcp — stdio MCP server image
#
# Separate from the CLI image on purpose. The CLI Dockerfile entrypoint is
# `vastlint check`. Glama (and any MCP client) handshake that container as an
# MCP server and get a CLI, not tools/list. This file is the one to point
# Glama's Dockerfile admin at: https://glama.ai/mcp/servers/aleksUIX/vastlint/admin/dockerfile
#
# Build from the repo root:
#   docker build -f Dockerfile.mcp -t vastlint-mcp .
# Run as stdio (no tags leave the container unless a tool fetches a URL):
#   docker run --rm -i vastlint-mcp
#
# Stage 1 — build a fully-static musl binary
#
# rust:alpine is the right base for musl static builds: Alpine ships a native
# musl toolchain so crates with C code (ring, via ureq/rustls, and mimalloc)
# compile cleanly. The debian-slim + musl-tools approach breaks ring because
# that musl-gcc wrapper does not support the -m64 flag ring's build script
# passes.
# ─────────────────────────────────────────────────────────────────────────────
FROM rust:alpine@sha256:3c38f3f82c2f3d73da3b38e18d279393a04cb43ddded0e35088a8c3324d40900 AS builder

RUN apk add --no-cache musl-dev gcc make perl

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

RUN cargo build --release --bin vastlint-mcp

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 — final image: scratch plus the static binary
#
# No OS, no shell, no package manager. The server speaks MCP over stdin/stdout.
# validate_vast_url and inspect_vast fetch over TLS using rustls + webpki roots
# bundled in the binary, so there is no CA bundle to copy in.
# ─────────────────────────────────────────────────────────────────────────────
FROM scratch

COPY --from=builder \
     /build/target/release/vastlint-mcp \
     /vastlint-mcp

# No arguments. MCP stdio is the only transport this image speaks.
ENTRYPOINT ["/vastlint-mcp"]
