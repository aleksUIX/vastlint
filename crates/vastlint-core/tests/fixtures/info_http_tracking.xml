<?xml version="1.0" encoding="UTF-8"?>
<VAST version="2.0">
  <Ad id="1">
    <InLine>
      <AdSystem>Test AdServer</AdSystem>
      <AdTitle>Test Ad</AdTitle>
      <!-- HTTP Impression — should fire VAST-2.0-tracking-https -->
      <Impression><![CDATA[http://example.com/impression]]></Impression>
      <Creatives>
        <Creative>
          <Linear>
            <Duration>00:00:30</Duration>
            <TrackingEvents>
              <!-- HTTP tracking pixel — should also fire VAST-2.0-tracking-https -->
              <Tracking event="start"><![CDATA[http://example.com/track/start]]></Tracking>
            </TrackingEvents>
            <VideoClicks>
              <!-- HTTP click URL — should also fire VAST-2.0-tracking-https -->
              <ClickThrough><![CDATA[http://example.com/click]]></ClickThrough>
            </VideoClicks>
            <MediaFiles>
              <MediaFile delivery="progressive" type="video/mp4" width="1920" height="1080">
                <![CDATA[https://example.com/video.mp4]]>
              </MediaFile>
            </MediaFiles>
          </Linear>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
</VAST>
