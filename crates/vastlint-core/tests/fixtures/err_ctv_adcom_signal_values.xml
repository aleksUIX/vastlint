<?xml version="1.0" encoding="UTF-8"?>
<!--
  Malformed AdCOM signal round-trip. Every Extension here is wrong in a
  different way:
    plcmt=12          out of the Plcmt Subtypes (Video) range 1-9
    pos=99            out of the Placement Positions range 0-17
    playbackmethod=40 out of the Playback Methods range 1-11
    attr=20           not a CTV motion attribute (21/22/23) — this is the exact
                      defect in IAB's own published example at line 1463
    type="loudness"   not an AdCOM signal name
    type="pos" carrying a <plcmt> payload — declared type and payload disagree
    playbackmethod payload "two" — not an integer
-->
<VAST version="4.2">
  <Ad id="adcom-bad-001">
    <InLine>
      <AdSystem version="1.0">ExampleAdServer</AdSystem>
      <AdTitle>Signal Round-Trip Defects</AdTitle>
      <Impression><![CDATA[https://track.example.com/imp?id=003]]></Impression>
      <AdServingId>ServerName-adcom-bad-001</AdServingId>
      <Creatives>
        <Creative id="creative-003" adId="AD-ID-003">
          <UniversalAdId idRegistry="ad-id.org">CNPA0484000H</UniversalAdId>
          <NonLinearAds>
            <NonLinear width="1920" height="1080">
              <StaticResource creativeType="image/jpeg"><![CDATA[https://cdn.example.com/pause.jpg]]></StaticResource>
            </NonLinear>
          </NonLinearAds>
        </Creative>
      </Creatives>
      <Extensions>
        <Extension type="plcmt" ext="adcom"><plcmt>12</plcmt></Extension>
        <Extension type="pos" ext="adcom"><pos>99</pos></Extension>
        <Extension type="playbackmethod" ext="adcom"><playbackmethod>40</playbackmethod></Extension>
        <Extension type="attr" ext="adcom"><attr>20</attr></Extension>
        <Extension type="loudness" ext="adcom"><attr>21</attr></Extension>
        <Extension type="pos" ext="adcom"><plcmt>5</plcmt></Extension>
        <Extension type="playbackmethod" ext="adcom"><playbackmethod>two</playbackmethod></Extension>
      </Extensions>
    </InLine>
  </Ad>
</VAST>
