{
  "uid": "vastlint-prebid",
  "title": "VASTLint monitors Prebid samples and collection health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "vastlint",
    "prebid"
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Completed samples by outcome",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, environment, outcome) (rate(vastlint_grpc_documents_total{cluster=~\"$cluster\",environment=~\"$environment\",caller=\"prebid-server\"}[5m]))",
          "legendFormat": "{{cluster}} {{environment}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Collection failures and losses",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, environment, event) (rate(prebid_server_vastlint_collection_total{cluster=~\"$cluster\",environment=~\"$environment\",event=~\"failed|capacity_dropped|rate_dropped|expired|shutdown_dropped\"}[5m]))",
          "legendFormat": "{{cluster}} {{environment}} {{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Documents affected by error rules",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (rule_id) (rate(vastlint_grpc_rule_documents_total{cluster=~\"$cluster\",environment=~\"$environment\",caller=\"prebid-server\",severity=\"error\"}[5m])))",
          "legendFormat": "{{rule_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rule-document pairs by effective severity",
      "description": "A document contributes once for each matching rule and severity. This sum is not a count of unique documents or individual finding occurrences.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (rate(vastlint_grpc_rule_documents_total{cluster=~\"$cluster\",environment=~\"$environment\",caller=\"prebid-server\"}[5m]))",
          "legendFormat": "{{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Auction sampling and privacy coverage",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, environment, event) (rate(prebid_server_vastlint_collection_total{cluster=~\"$cluster\",environment=~\"$environment\",event=~\"auctions|sampled|privacy_suppressed|activity_denied|no_candidate\"}[5m]))",
          "legendFormat": "{{cluster}} {{environment}} {{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Active rule policy and engine",
      "description": "Compare profile, policy digest, engine and catalog before attributing a metric change to traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vastlint_grpc_policy_info{cluster=~\"$cluster\",environment=~\"$environment\"}",
          "legendFormat": "{{cluster}} {{environment}} {{profile}} {{engine_version}} {{policy_digest}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "cluster": 0,
              "environment": 1,
              "instance": 2,
              "profile": 3,
              "engine_version": 4,
              "policy_digest": 5,
              "catalog_digest": 6
            }
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(vastlint_grpc_policy_info, cluster)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(vastlint_grpc_policy_info, environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  }
}
