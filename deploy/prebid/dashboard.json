{
  "uid": "vastlint-prebid",
  "title": "VASTLint monitors Prebid samples and collection health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "vastlint",
    "prebid"
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Completed samples by outcome",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, environment, outcome) (rate(vastlint_grpc_documents_total{caller=\"prebid-server\"}[5m]))",
          "legendFormat": "{{cluster}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Collection failures and losses",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, environment, event) (rate(prebid_server_vastlint_collection_total{event=~\"failed|capacity_dropped|rate_dropped|expired|shutdown_dropped\"}[5m]))",
          "legendFormat": "{{cluster}} {{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Documents affected by error rules",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (rule_id) (rate(vastlint_grpc_rule_documents_total{caller=\"prebid-server\",severity=\"error\"}[5m])))",
          "legendFormat": "{{rule_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Document findings by effective severity",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (rate(vastlint_grpc_rule_documents_total{caller=\"prebid-server\"}[5m]))",
          "legendFormat": "{{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Auction sampling and privacy coverage",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, event) (rate(prebid_server_vastlint_collection_total{event=~\"auctions|sampled|privacy_suppressed|activity_denied|no_candidate\"}[5m]))",
          "legendFormat": "{{cluster}} {{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Active rule policy and engine",
      "description": "Counters describe received samples. Rule-document counts may overlap across rules and severities. Collection loss counters are shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vastlint_grpc_policy_info",
          "legendFormat": "{{cluster}} {{profile}} {{engine_version}} {{policy_digest}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
