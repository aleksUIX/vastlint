# Build tooling — not needed by consumers
scripts/

# macOS
.DS_Store

# Explicitly un-ignore wasm-pack build output so it overrides .gitignore
# (npm reads .gitignore in the package dir; pkg/ and pkg-node/ are listed there
# as git-ignored build artifacts, but they ARE intentionally published to npm)
!pkg/
!pkg-node/
!vastlint_wasm_bg.wasm
