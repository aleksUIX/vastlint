{
  "name": "vastlint",
  "version": "0.11.8",
  "description": "Validate VAST 2.0–4.4, VMAP 1.0, and DAAST 1.0 ad tags against IAB specs. 223 rules. Rust/WASM core.",
  "license": "Apache-2.0",
  "author": "Alex Sekowski <alex@vastlint.org>",
  "homepage": "https://vastlint.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksUIX/vastlint.git"
  },
  "keywords": [
    "vast",
    "vast-xml",
    "vast-validator",
    "vast-linter",
    "vast-parser",
    "vast-tag",
    "vast-wrapper",
    "simid",
    "vpaid",
    "xml",
    "validator",
    "linter",
    "adtech",
    "iab",
    "ctv",
    "ssai",
    "video",
    "advertising",
    "programmatic",
    "creative-validation",
    "mcp",
    "wasm"
  ],
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    },
    "./index.cjs": "./index.cjs",
    "./vastlint_wasm_cjs.js": "./vastlint_wasm_cjs.js",
    "./vastlint_wasm_bg.js": "./vastlint_wasm_bg.js",
    "./vastlint_wasm_bg.wasm": "./vastlint_wasm_bg.wasm"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "vastlint_wasm.js",
    "vastlint_wasm.d.ts",
    "vastlint_wasm_bg.js",
    "vastlint_wasm_bg.wasm",
    "vastlint_wasm_bg.wasm.d.ts",
    "vastlint_wasm_cjs.js",
    "README.md"
  ],
  "scripts": {
    "build": "wasm-pack build ../crates/vastlint-wasm --target bundler --out-dir ../../npm/pkg && wasm-pack build ../crates/vastlint-wasm --target nodejs --out-dir ../../npm/pkg-node && node scripts/assemble.js",
    "test:runtime": "npm run build && node --test scripts/runtime-smoke.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
