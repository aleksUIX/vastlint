{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "vastlint": ["../../npm/index.d.ts"]
    },
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*.ts"]
}