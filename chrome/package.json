{
  "name": "vastlint-extension",
  "version": "0.15.3",
  "private": true,
  "description": "Chrome extension that detects VAST XML in the DOM and displays inline validation errors/warnings powered by VASTlint WASM",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "clean": "rm -rf dist",
    "test": "node --test test/build.test.mjs"
  },
  "dependencies": {
    "vastlint": "file:../npm"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.299",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
